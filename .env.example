# FirstFrame - plantilla de entorno.
#
#   cp .env.example .env      # .env esta en .gitignore y ahi se queda
#
# AQUI NO HAY NI UN SECRETO REAL. Los valores marcados <...> se rellenan a mano.
# En produccion no se usa este fichero: los secretos van por `fly secrets set`.
#
# Bootstrap completo desde cero (un juez con su propia cuenta B2):
#   1. crear el bucket CON Object Lock (solo se puede activar al crearlo):
#        b2 bucket create <bucket> allPrivate --fileLockEnabled
#   2. .venv/bin/python infra/make_keys.py     # crea las 2 keys restringidas
#   3. .venv/bin/python infra/b2_setup.py      # lifecycle + event rules, idempotente


# ===========================================================================
# B2 - credenciales que usa la app
# ===========================================================================
# Estas dos son las que lee todo el codigo (server/b2.py, pipeline/, genblaze).
# En la maquina de desarrollo apuntan a la master key; en el deploy apuntan a
# la key RESTRINGIDA `firstframe-server` que genera infra/make_keys.py.
B2_KEY_ID=<applicationKeyId>
B2_APP_KEY=<applicationKey>

B2_REGION=eu-central-003
B2_BUCKET=genblaze-review-migarci2
# Endpoint S3 derivado: https://s3.${B2_REGION}.backblazeb2.com


# ===========================================================================
# B2 - application keys restringidas (infra/make_keys.py)
# ===========================================================================
# Multi-tenancy a nivel de storage, no de aplicacion. Las crea y las VERIFICA
# contra la API real infra/make_keys.py.

# Master key de la cuenta. Solo hace falta para correr infra/make_keys.py
# (capability `writeKeys`). Si esta puesta, make_keys.py la prefiere sobre
# B2_KEY_ID, para que B2_KEY_ID pueda ser ya la key restringida.
B2_MASTER_KEY_ID=<master applicationKeyId>
B2_MASTER_APP_KEY=<master applicationKey>

# `firstframe-server`: 20 capabilities, acotada a UN bucket. No puede crear ni
# destruir buckets, ni crear keys. Es la que se pone en `fly secrets`.
B2_SERVER_KEY_ID=<generado por make_keys.py>
B2_SERVER_APP_KEY=<generado por make_keys.py — B2 lo muestra UNA sola vez>

# `firstframe-reviewer`: capability UNICA `readFiles`, acotada al prefijo
# `approved/` de ese mismo bucket. Verificado contra la API: escritura -> 401,
# listado -> 403 AccessDenied, lectura fuera de approved/ -> 403 AccessDenied.
# El revisor externo del cliente literalmente no tiene una key que pueda escribir.
B2_REVIEWER_KEY_ID=<generado por make_keys.py>
B2_REVIEWER_APP_KEY=<generado por make_keys.py — B2 lo muestra UNA sola vez>


# ===========================================================================
# B2 - Event Notifications
# ===========================================================================
# Secreto HMAC compartido con las 5 reglas del bucket. B2 firma cada webhook y
# manda `X-Bz-Event-Notification-Signature: v1=<hex>`; server/events.py compara
# contra hmac_sha256(secret, cuerpo_crudo). 32 caracteres alfanumericos:
#   python -c "import secrets; print(secrets.token_hex(16))"
B2_WEBHOOK_SECRET=<32 chars hex>

# Destino de las reglas. Por defecto ${PUBLIC_BASE_URL}/webhooks/b2.
# B2_WEBHOOK_URL=https://firstframe.fly.dev/webhooks/b2

# webhook | poll | both
# Esta cuenta tiene la Event Notifications API gated (B2 responde
# 400 "API not enabled"), asi que el valor efectivo es `poll`: server/events.py
# :Poller lista incoming/, approved/ y provenance/ cada 2 s y emite los MISMOS
# eventos internos. infra/b2_setup.py lo detecta y avisa. Cuando B2 habilite la
# API para la cuenta, las reglas ya estan escritas: basta con poner `both`.
EVENTS_MODE=poll


# ===========================================================================
# App
# ===========================================================================
# mock  -> MockProvider/MockVideoProvider + clips ffmpeg testsrc2. Coste $0.
# real  -> proveedores de verdad (NIM, GMICloud, OpenAI).
DEMO_MODE=mock

PUBLIC_BASE_URL=http://localhost:8000
PORT=8000

# STUB=1 sirve datos fake sin B2 ni pipeline (lo usa el frontend para desarrollar).
# STUB=0
# FORCE_STUB_RUNNER=0

# Escenas por spot, segundos por segmento HLS, umbral del juez del AgentLoop.
SCENE_COUNT=6
HLS_SEG_SECONDS=4
JUDGE_THRESHOLD=0.7

# Rutas de estado. En el contenedor apuntan a /data (ver Dockerfile y fly.toml).
FIRSTFRAME_DB=data/firstframe.db
FIRSTFRAME_WORK=data/work
FIRSTFRAME_HLS=data/hls
CHAOS_FILE=data/chaos.json


# ===========================================================================
# Proveedores de modelos (opcionales con DEMO_MODE=mock)
# ===========================================================================
# Chat + vision (juez del AgentLoop: meta/llama-3.2-90b-vision-instruct).
# Generacion de imagen NO disponible en la free tier: ver VALIDACION.md.
NVIDIA_API_KEY=<nvapi-...>

# tts-1 para el voiceover y gpt-4o-mini vision como juez alternativo.
OPENAI_API_KEY=<sk-...>

# pixverse-v5.6 (video, ~$0.03/asset) con fallback seedance-2-0.
# NUNCA para audio: el conector de audio de GMICloud esta roto (issue #251).
GMI_API_KEY=<...>
